# LazyEASM Environment Variables
# Copy this file to .env and fill in your values

# HTTPS served by LazyEASM itself:
#   self-signed  certificate generated on first start (browsers warn once; the
#                SHA-256 fingerprint is printed at startup and in Settings > Account)
#   custom       your certificate: TLS_CERT_FILE / TLS_KEY_FILE (PEM)
#   off          plain HTTP, e.g. behind a reverse proxy that handles HTTPS
# New installs get self-signed. TLS_HOSTNAMES adds names/IPs to the
# self-signed certificate (comma separated), e.g. the server's public IP.
TLS_MODE=self-signed
TLS_CERT_FILE=
TLS_KEY_FILE=
TLS_HOSTNAMES=
# The address you open LazyEASM at (the installer detects it): shown at
# startup and added to the self-signed certificate
PUBLIC_IP=

# Behind a reverse proxy instead: TLS_MODE=off, FORCE_HTTPS=true (Secure
# cookies + HSTS) and TRUST_PROXY=true (proxy sets X-Forwarded-For / -Proto).
FORCE_HTTPS=false
TRUST_PROXY=false

# Debug mode enables the interactive Werkzeug debugger. Never enable it on a
# reachable host. (FLASK_ENV no longer controls debug; FLASK_ENV=production is
# still honored as FORCE_HTTPS=true.)
FLASK_DEBUG=false

# SecurityTrails API Key (for subdomain discovery)
# Get your key at: https://securitytrails.com/
SECURITYTRAILS_API_KEY=

# NVD API Key (optional, for CVE matching)
# Without a key NVD allows 5 requests per 30 seconds; with a key, 50.
# Request one at: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# AI recommendations
# AI_PROVIDER: gemini (default), anthropic, openai, or openai_compatible
# AI_MODEL: optional for gemini/anthropic (provider default), required for openai/openai_compatible
# AI_BASE_URL: only for openai_compatible, e.g. http://localhost:11434/v1 for Ollama
AI_PROVIDER=gemini
AI_MODEL=
AI_BASE_URL=

# Subdomain discovery
# AlienVault OTX key (optional, adds a passive DNS source): https://otx.alienvault.com/
OTX_API_KEY=
# Optional: raises the CertSpotter quota for certificate transparency lookups
# (CertSpotter is tried first, crt.sh only as a fallback). Also editable in the dashboard
CERTSPOTTER_API_KEY=
# DNS brute force and permutations of known subdomains (skipped on wildcard DNS).
# Also editable in the dashboard (Configuration > Discovery)
DNS_BRUTEFORCE=true

# Google Gemini API Key
# Get your key at: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=

# Anthropic API Key (when AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=

# OpenAI API Key (when AI_PROVIDER=openai; optional for openai_compatible)
OPENAI_API_KEY=

# Discord Webhook URL (for notifications)
# Format: https://discord.com/api/webhooks/WEBHOOK_ID/WEBHOOK_TOKEN
# Create webhook in your Discord server: Server Settings > Integrations > Webhooks
DISCORD_WEBHOOK_URL=

# Discord User ID (optional - user to ping on alerts)
# Find your ID: Enable Developer Mode in Discord > Right-click your name > Copy ID
DISCORD_USER_ID=

# More notification channels (all configured channels receive every alert)
# Slack incoming webhook
SLACK_WEBHOOK_URL=
# Generic JSON webhook; with a secret the body is signed:
# X-LazyEASM-Signature: sha256=<hex HMAC-SHA256 of the raw body>
NOTIFY_WEBHOOK_URL=
NOTIFY_WEBHOOK_SECRET=
# Email via SMTP (SMTP_SECURITY: starttls, ssl or none; SMTP_TO: comma separated)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=

# Flask Secret Key (for session encryption)
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# JWT Secret (for token signing)
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# Admin Credentials (for dashboard login)
# Leave empty: on first start LazyEASM prints a one-time setup code and you
# create the account in the browser. ADMIN_PASS (with ADMIN_USER, default
# lazymin) creates it without the browser instead, and resets a lost password
# (the username stays as it was unless ADMIN_USER is set). It is stored hashed
# and removed from this file on startup.
ADMIN_USER=
ADMIN_PASS=

# Asset API pagination (per-request maximum, safe default for UI/API consumers)
ASSET_API_MAX_PAGE_SIZE=100

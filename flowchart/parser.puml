@startuml Parser Module Flowchart
skinparam backgroundColor #FEFEFE
skinparam shadowing false
skinparam defaultFontSize 12
skinparam ArrowColor #333333
skinparam ActivityBorderColor #4A90D9
skinparam ActivityBackgroundColor #E8F4FD
skinparam ActivityDiamondBackgroundColor #FFF3CD
skinparam ActivityDiamondBorderColor #FFC107
skinparam NoteBorderColor #6C757D
skinparam NoteBackgroundColor #F8F9FA

title LazyEASM - Parser Module (Parser.py)\nInput Processing Pipeline

start

:Receive raw_input\n(newline/comma separated targets);

:Initialize InputParser\n(allow_private, max_cidr=/20);

:Split input by newline/comma;
:Strip whitespace, filter empty;

partition "Step 1: Normalize" {
  :**normalize_target()** for each target;
  note right
    - Strip protocol (http/https)
    - Extract port hint (:8080)
    - Extract path hint (/admin)
    - Strip trailing dots
    - Classify type via _determine_type()
  end note

  :Classify each target as:\nIP | CIDR | Range | Domain | Subdomain | Invalid;
}

partition "Step 2: Categorize & Validate" {
  :**categorize_targets()**;

  fork
    :**IP**\nvalidate_ip()\n- Check IPv4 format\n- Reject private/loopback/multicast\n  (unless allow_private);
  fork again
    :**CIDR**\nexpand_cidr()\n- Max expansion: /20 (4094 IPs)\n- Validate each expanded IP;
  fork again
    :**Range**\nexpand_range()\n- Expand start-end range\n- Validate each IP;
  fork again
    :**Domain**\nvalidate_domain()\n- Regex format check\n- TLD validation via tldextract;
  fork again
    :**Subdomain**\nvalidate_domain()\n- Same checks as domain\n- Extract parent domain;
  fork again
    :**Invalid**\nCollect with reason;
  end fork

  :Collect port & path hints\nper target;
}

partition "Step 3: Deduplicate" {
  :**check_duplicates()** against database;
  note right
    Query each target against:
    - domain_asset table (domains)
    - subdomain_asset table (subdomains)
    - ip_asset table (IPs)
  end note

  :Separate into:\n- new_ips, new_domains, new_subdomains\n- existing_ips, existing_domains, existing_subdomains;
}

partition "Step 4-10: Process New Assets" {

  :Process **new_domains**;

  fork
    :resolve_domain()\nDNS lookup (A records);
    if (Wildcard detected?) then (Yes)
      :Flag is_wildcard=1\nStore wildcard_ip;
      note right
        is_wildcard_domain() tests
        3 random subdomains to confirm
        all resolve to same IP
      end note
    else (No)
      :is_wildcard=0;
    endif
  fork again
    :ping_host()\nICMP ping (2 attempts);
    if (Host alive?) then (Yes)
      :status = 'up';
    else (No)
      :status = 'down';
    endif
  end fork

  :upsert_domain() to database;
  :Create domain→IP resolution links;

  :Check shared hosting for each resolved IP;
  if (Shared/CDN IP?) then (Yes)
    :is_shared=1, store provider\n(e.g. Cloudflare, AWS);
  else (No)
    :is_shared=0;
  endif

  :upsert_ip() for each resolved IP;
  :create_domain_resolution();

  :Save port/path hints\nvia save_scan_hint();

  :Process **new_subdomains**;

  :Ensure parent domain exists\n(create if needed);
  :resolve_domain() for subdomain;
  :ping_host() for subdomain;
  :upsert_subdomain() to database;

  :Check shared hosting for each resolved IP;
  :upsert_ip() for each resolved IP;
  :create_subdomain_resolution();
  :Save port/path hints;

  :Process **new_IPs**;

  :ping_host() for each IP;
  :Check shared hosting;
  :upsert_ip() to database;
  :Save port hints;
}

partition "Output" {
  :Build result dict;

  :Return result:\n{
    status: 'success' | 'no_new_assets'
    stats: { new_domains, new_subdomains, new_ips, ... }
    new_assets: { domains, subdomains, IPs, wildcard_domains }
    existing_assets: { domains, subdomains, IPs }
    down_assets: { domains, subdomains, IPs }
    invalid: [ { input, reason } ]
    hints_saved: [ { target, type, values } ]
  };
}

:log_scan() to database;

stop

@enduml